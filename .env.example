# --- Notion (blog) ---
# Internal Integration Secret from https://www.notion.so/my-integrations
NOTION_TOKEN=

# 32-char database ID from your Notion blog DB URL.
# Leave blank — the `npm run notion:setup` script will create the DB and print this for you.
NOTION_BLOG_DB_ID=

# Parent page ID — only used by `npm run notion:setup`. The DB will be created inside this page.
# Get it: open the page in Notion -> copy URL -> the 32-char string at the end is the page ID.
NOTION_PARENT_PAGE_ID=

# --- Revalidation webhook ---
# Any random 32+ char string. Shared between GitHub Actions / Notion and your /api/revalidate route.
REVALIDATE_SECRET=

# --- Email (contact form) ---
# https://resend.com -> API Keys
RESEND_API_KEY=

# Where to receive contact form submissions
CONTACT_EMAIL=officialkaran39@gmail.com

# Sender address. Use Resend's onboarding sender until you verify a domain.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- AI chatbot (portfolio assistant) ---
# Preferred: Groq (free, fast, LLaMA 3.3-70B) -> https://console.groq.com/keys
GROQ_API_KEY=
# Optional override, defaults to llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Fallback provider if GROQ_API_KEY is unset: OpenAI -> https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# If neither key is set, the chat widget shows a graceful "not configured" message.

# --- Site ---
# Used for OG tags / canonical URLs. Set to your prod URL once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
